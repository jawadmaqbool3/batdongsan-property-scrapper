# STORAGE picks which DB backend the three workers talk to.
#   postgres : libpq URL in DATABASE_URL (Neon, Supabase, RDS, …)  ← default
#   mysql    : DB_HOST / DB_PORT / DB_USER / DB_PASSWORD / DB_NAME below
STORAGE=postgres
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Only read when STORAGE=mysql.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=property

# --- FTP image upload ---
# Public URL pattern stored in DB:  {FTP_PUBLIC_BASE}/{listing_code}/{filename}
FTP_HOST=
FTP_USER=
FTP_PASSWORD=
FTP_REMOTE_ROOT=/properties
FTP_PUBLIC_BASE=
FTP_TIMEOUT=30
# Pace knobs for the background uploader (src/ftp_upload.py).
FTP_SLEEP_BETWEEN_LISTINGS_SEC=1
FTP_SLEEP_WHEN_IDLE_SEC=60

# --- Scraper ---
HEADLESS=false
MAX_PAGES_PER_CATEGORY=0           # 0 = walk pagination until exhausted
MAX_CONSECUTIVE_FAILURES=5
REQUEST_DELAY_MIN_MS=800
REQUEST_DELAY_MAX_MS=2000
# Scraper proxy (the finder reads its own per-row proxy list from data/proxies.csv)
PROXY_SERVER=
PROXY_USER=
PROXY_PASSWORD=
# Optional login for the scraper's phone-reveal helpers.
SOURCE_USERNAME=
SOURCE_PASSWORD=

# --- Phone finder ---
# Accounts + proxies live in CSVs:
ACCOUNTS_CSV=data/accounts.csv
PROXIES_CSV=data/proxies.csv
# Sleep range between phone reveals (default ~5 min per account).
AGENT_FETCH_DELAY_MIN_SEC=270
AGENT_FETCH_DELAY_MAX_SEC=330
# When Cloudflare blocks or a login fails, cool that (account/proxy) for this long.
ACCOUNT_COOLDOWN_SEC=1800
FINDER_HEADLESS=false

# --- main.py per-worker switches ---
RUN_SCRAPER=true
RUN_FTP_UPLOAD=true
RUN_FINDER=true
